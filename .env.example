DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nargile_saas
SECRET_KEY=change-me-to-a-random-64-char-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEBUG=True

# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PayTR (card payments). Key and salt come from the PayTR merchant panel; card
# payment stays switched off until both are set.
PAYTR_MERCHANT_ID=171085
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# 1 while testing (test cards, nothing charged); 0 in production.
PAYTR_TEST_MODE=1
PAYTR_OK_URL=http://localhost:3000/orders/{order_id}/confirmation?payment=ok
PAYTR_FAIL_URL=http://localhost:3000/orders/{order_id}/confirmation?payment=failed

# ── E-mail ───────────────────────────────────────────────────────────────
# EMAIL_DRIVER: auto (SMTP when SMTP_HOST is set, else mock) | smtp | resend | mock.
# The mock driver logs every message and records it, sending nothing.
EMAIL_DRIVER=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
MAIL_FROM=siparis@nargilemalzemesi.com
MAIL_FROM_NAME=Nargile Malzemesi
RESEND_API_KEY=

# ── SMS ──────────────────────────────────────────────────────────────────
# SMS_DRIVER: mock (log only) | netgsm | iletimerkezi | webhook.
SMS_DRIVER=mock
# The sender name (başlık) approved by the gateway.
SMS_SENDER=
# Netgsm account (abone no / alt kullanıcı), API password and header (başlık,
# falls back to SMS_SENDER). Admin › İletişim › SMS Ayarları can hold all
# three instead; a field left blank there falls back to these, and an account
# saved there sends through Netgsm whatever SMS_DRIVER says.
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=
ILETIMERKEZI_API_KEY=
ILETIMERKEZI_API_HASH=
# Generic gateway: POSTs {"to": [...], "message": "...", "sender": "..."} with
# "Authorization: Bearer <SMS_WEBHOOK_TOKEN>".
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# Opt-out line added to campaign SMS (İYS / ETK), e.g. "Ret icin RET yaz 3XXX'e gonder. B001"
SMS_OPT_OUT_TEXT=

# ── Password reset ───────────────────────────────────────────────────────
PASSWORD_RESET_URL=http://localhost:3000/sifre-yenile?token={token}
PASSWORD_RESET_TTL_MINUTES=30

# Yurtiçi Kargo web service. Two accounts under one customer code (müşteri
# kodu): GO (gönderici ödemeli) for parcels the shop pays, AO (alıcı ödemeli)
# for karşı ödemeli ones. Empty GO pair = tracking codes by hand only; empty AO
# pair = karşı ödemeli orders by hand only.
# Test: YKTEST / YK as the GO pair with YURTICI_TEST_MODE=1 (Yurtiçi's public
# test account). YURTICI_TEST_MODE=1 uses the test service whatever the WSDL
# URL says; set 0 to ship for real.
YURTICI_MUSTERI_KODU=
YURTICI_API_USER_GO=
YURTICI_API_PASS_GO=
YURTICI_API_USER_AO=
YURTICI_API_PASS_AO=
YURTICI_WSDL_URL=https://ws.yurticikargo.com/KOPSWebServices/ShippingOrderDispatcherServices?wsdl
YURTICI_API_LANGUAGE=TR
YURTICI_TEST_MODE=1
# Before the GO/AO split: still read (as the GO account) when the above are empty.
# YURTICI_API_USER= / YURTICI_API_PASSWORD= / YURTICI_CUSTOMER_CODE=
